          "value": "YOUR_GOOGLE_CALENDAR_ID",
          "mode": "list",
          "cachedResultName": "Select your calendar after import"
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Start', `Meeting start date/time in ISO 8601 format with Europe/Berlin timezone.`, 'string') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('End', `Meeting end date/time in ISO 8601 format with Europe/Berlin timezone.`, 'string') }}",
